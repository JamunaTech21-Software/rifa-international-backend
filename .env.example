# ---- App ----
APP_ENV=local                 # local | testing | staging | production
APP_DEBUG=true                # must be false on staging/production
APP_URL=http://localhost:5173 # public site URL
ADMIN_URL=http://localhost:5174 # admin app URL, used for links in emails (default: APP_URL/admin)
APP_TIMEZONE=Asia/Dhaka
LOG_LEVEL=debug               # debug | info | warning | error

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=rifa_local
DB_USERNAME=root
DB_PASSWORD=

# ---- Session / security ----
SESSION_NAME=rifa_session
SESSION_SECURE=false          # true on HTTPS (staging/production)
SESSION_IDLE_MINUTES=60
TRUSTED_PROXY_SECRET=         # long random string; the same value is set in Vercel (see DEPLOY.md). Empty = trust nobody

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_APPLICATIONS_FOLDER=rifa/applications

# ---- Mail ----
MAIL_DRIVER=log               # log | smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl           # ssl | tls
MAIL_FROM_ADDRESS=info@rifaint.com
MAIL_FROM_NAME="Rifa International"
MAIL_OFFICE_TO=info@rifaint.com

# Cloudflare Turnstile on Apply + Contact (P5-06). Enable only once the frontend shows the widget.
# Local test secret that always passes: 1x0000000000000000000000000000000AA (always fails: 2x0000000000000000000000000000000AA)
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
