{
    "name": "jamunatech/rifa-backend",
    "description": "RIFA International — job application & messaging API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "cloudinary/cloudinary_php": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "process-timeout": 0
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "migrate": "php database/migrate.php",
        "migrate:fresh": "php database/migrate.php --fresh",
        "seed": "php database/seed.php",
        "seed:admin": "php database/seeds/seed_admin.php",
        "test": "phpunit"
    }
}
