# Production .env for ~/rifa_backend/.env (chmod 600). Run `php bin/check-config.php` after editing.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rifaint.com
ADMIN_URL=https://admin.rifaint.com
APP_TIMEZONE=Asia/Dhaka
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_rifa_prod
DB_USERNAME=cpaneluser_rifa
DB_PASSWORD=

SESSION_NAME=rifa_session
SESSION_SECURE=true
SESSION_IDLE_MINUTES=60
TRUSTED_PROXY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_APPLICATIONS_FOLDER=rifa/applications

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@rifaint.com
MAIL_FROM_NAME="Rifa International"
MAIL_OFFICE_TO=info@rifaint.com
